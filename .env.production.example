# =============================================================
# Micrositio OICM — Variables de entorno PRODUCCIÓN
# =============================================================
# 1. En el servidor:  cp .env.production.example .env
# 2. Edita con tus valores reales (contraseñas, dominio).
# 3. Genera APP_KEY (una sola vez, guárdala en lugar seguro):
#      docker compose --env-file .env -f deploy/docker-compose.production.yml \
#        run --rm app php artisan key:generate --show
#    Si cambias APP_KEY, todas las sesiones activas se invalidan.
#
# NUNCA subas el .env con valores reales a GitHub (está en .gitignore).
# =============================================================

APP_NAME="Órgano Interno de Control Municipal"
APP_ENV=production
APP_KEY=                                  # ← OBLIGATORIO: artisan key:generate
APP_DEBUG=false                           # NUNCA true en producción (fuga de stack traces)
APP_URL=https://oicm.municipiodeoaxaca.gob.mx

APP_PORT=8088                             # Puerto que Docker expone en el servidor

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Logs ---
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Base de datos MySQL (contenedor docker-compose.mysql.yml) ---
DB_CONNECTION=mysql
DB_HOST=oicm_mysql                        # ← Nombre del contenedor MySQL (no cambiar)
DB_PORT=3306
DB_DATABASE=oicm
DB_USERNAME=oicm_user                     # ← contraseña ≥ 20 caracteres
DB_PASSWORD=CAMBIA_ESTA_CONTRASEÑA_USUARIO
DB_ROOT_PASSWORD=CAMBIA_ESTA_CONTRASEÑA_ROOT

# --- Sesiones (endurecidas) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true                # requiere HTTPS; activa el flag Secure
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=oicm.municipiodeoaxaca.gob.mx

# --- Caché y colas ---
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Correo ---
MAIL_MAILER=log                           # cambia a smtp cuando exista servidor de correo real
MAIL_FROM_ADDRESS="oicm@municipiodeoaxaca.gob.mx"
MAIL_FROM_NAME="${APP_NAME}"

# NOTA sobre el usuario admin: UsuarioSeeder (database/seeders/UsuarioSeeder.php)
# crea dos cuentas de prueba con contraseña fija ('Oicm#Control2026'). El
# script de deploy SOLO siembra en el primer despliegue (ver
# context/deploy.md §6) para no resetear esa contraseña ni las ediciones del
# panel en cada deploy. Cambia esa contraseña desde /perfil inmediatamente
# después del primer login en producción — es un requisito de go-live, no
# opcional (ver checklist §7).

VITE_APP_NAME="${APP_NAME}"
