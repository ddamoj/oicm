# =============================================================
# Micrositio OICM — Variables de entorno STAGING
# =============================================================
# El script deploy-staging.sh crea y completa este archivo automáticamente
# (genera DB_PASSWORD, DB_ROOT_PASSWORD y APP_KEY). Solo edítalo si necesitas
# ajustar el dominio, el puerto o las credenciales del admin.
#
# NUNCA subas el .env con valores reales a GitHub.
# =============================================================

APP_NAME="OICM · Staging"
APP_ENV=production                        # 'production' para probar el sitio endurecido de verdad
APP_KEY=
APP_DEBUG=false
APP_URL=https://oicmtest.municipiodeoaxaca.gob.mx   # dominio real de staging (HTTPS)

APP_PORT=8088                             # Docker expone este puerto; el proxy/HTTPS enruta el dominio aquí

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Logs ---
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- Base de datos MySQL (servicio 'mysql' del mismo compose) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=oicm_staging
DB_USERNAME=oicm_user
DB_PASSWORD=            # ← lo genera deploy-staging.sh
DB_ROOT_PASSWORD=      # ← lo genera deploy-staging.sh

# --- Sesiones ---
# Staging ya corre tras HTTPS (oicmtest.municipiodeoaxaca.gob.mx), así que
# SESSION_SECURE_COOKIE=true (cookie solo por HTTPS). Si algún día pruebas por
# IP:puerto sin TLS y no puedes iniciar sesión, ponlo temporalmente en false.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Caché y colas ---
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Correo (Mailpit no aplica en staging/producción; ajustar si hay SMTP real) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="oicm@municipiodeoaxaca.gob.mx"
MAIL_FROM_NAME="${APP_NAME}"

# NOTA sobre el usuario admin: no hay variables ADMIN_EMAIL/ADMIN_PASSWORD —
# UsuarioSeeder (database/seeders/UsuarioSeeder.php) crea dos cuentas de
# prueba con contraseña fija ('Oicm#Control2026'). El script de deploy
# SOLO siembra en el primer despliegue (ver context/deploy.md §5) para no
# resetear esa contraseña ni las ediciones del panel en cada deploy.
# Cambia esa contraseña desde /perfil inmediatamente después del primer
# login en staging.

VITE_APP_NAME="${APP_NAME}"
